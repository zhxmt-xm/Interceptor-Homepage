{
  "chapter": "composer-replay",
  "title": {
    "zh-CN": "逐步骤实操：重复 Query、Text 输入与历史重发",
    "en": "Recorded walkthrough: repeated Query, Text input and history replay"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "initialUrl": "http://127.0.0.1:65227/guide/composer-replay/query?guide=url",
    "initialSentUrl": "http://127.0.0.1:65227/guide/composer-replay/query?guide=url&guide=table&guide=again",
    "initialMethod": "POST",
    "queryName": "guide",
    "urlQueryValue": "url",
    "firstTableValue": "table",
    "secondTableValue": "again",
    "textUrl": "http://127.0.0.1:65227/guide/composer-replay/text?guide=text-url",
    "textSentUrl": "http://127.0.0.1:65227/guide/composer-replay/text?guide=text-url&guide=table&guide=again",
    "textMethod": "PUT",
    "textPartial": "Hello",
    "textBody": "Hello text",
    "textContentType": "not added automatically in Text mode; this example leaves the Header unset",
    "currentTableValue": "current",
    "currentBody": "Hello replay",
    "restoredMethod": "POST",
    "restoredUrl": "http://127.0.0.1:65227/guide/composer-replay/query?guide=url&guide=table&guide=again",
    "replaySentUrl": "http://127.0.0.1:65227/guide/composer-replay/query?guide=url&guide=table&guide=again&guide=current&guide=again",
    "replayQueryValues": "url, table, again, current, again",
    "historyRestores": "method and previously composed URL only; enabled current Query rows append again"
  },
  "steps": [
    {
      "id": "01-open",
      "title": "打开 Composer / Open Composer",
      "image": "composer-replay-01-open.png"
    },
    {
      "id": "02-new",
      "title": "新建 Query 与重发请求 / Create the Query and replay request",
      "image": "composer-replay-02-new.png"
    },
    {
      "id": "03-url",
      "title": "在 URL 中填写 guide=url / Enter guide=url in the URL",
      "image": "composer-replay-03-url.png"
    },
    {
      "id": "04-post",
      "title": "选择 POST / Select POST",
      "image": "composer-replay-04-post.png"
    },
    {
      "id": "05-query",
      "title": "打开仍为空的 Query 表格 / Open the still-empty Query table",
      "image": "composer-replay-05-query.png"
    },
    {
      "id": "06-query-name",
      "title": "填写 Query 名称 guide / Enter the Query name guide",
      "image": "composer-replay-06-query-name.png"
    },
    {
      "id": "07-query-value",
      "title": "填写 Query 值 table / Enter the Query value table",
      "image": "composer-replay-07-query-value.png"
    },
    {
      "id": "08-add-query",
      "title": "添加 guide=table / Add guide=table",
      "image": "composer-replay-08-add-query.png"
    },
    {
      "id": "09-duplicate-name",
      "title": "再次填写同名 guide / Enter the duplicate name guide",
      "image": "composer-replay-09-duplicate-name.png"
    },
    {
      "id": "10-duplicate-value",
      "title": "填写第二行值 again / Enter the second row value again",
      "image": "composer-replay-10-duplicate-value.png"
    },
    {
      "id": "11-add-duplicate",
      "title": "添加第二条同名 Query / Add the second same-name Query row",
      "image": "composer-replay-11-add-duplicate.png"
    },
    {
      "id": "12-send-query",
      "title": "发送并核对三个 guide 值 / Send and verify all three guide values",
      "image": "composer-replay-12-send-query.png"
    },
    {
      "id": "13-text-url",
      "title": "只修改主机与路径为文本地址 / Edit only host and path for the text URL",
      "image": "composer-replay-13-text-url.png"
    },
    {
      "id": "14-put",
      "title": "将方法改为 PUT / Change the method to PUT",
      "image": "composer-replay-14-put.png"
    },
    {
      "id": "15-body",
      "title": "打开请求 Body / Open request Body",
      "image": "composer-replay-15-body.png"
    },
    {
      "id": "16-text-mode",
      "title": "选择 Text，暂不输入 / Select Text before entering content",
      "image": "composer-replay-16-text-mode.png"
    },
    {
      "id": "17-text-partial",
      "title": "输入中间态 Hello / Enter the intermediate text Hello",
      "image": "composer-replay-17-text-partial.png"
    },
    {
      "id": "18-text-complete",
      "title": "继续输入为 Hello text / Complete the text as Hello text",
      "image": "composer-replay-18-text-complete.png"
    },
    {
      "id": "19-send-text",
      "title": "发送并核对 Hello text 字节 / Send and verify Hello text bytes",
      "image": "composer-replay-19-send-text.png"
    },
    {
      "id": "20-query-again",
      "title": "回到 Query 表格 / Return to the Query table",
      "image": "composer-replay-20-query-again.png"
    },
    {
      "id": "21-query-current",
      "title": "将 table 改为 current / Change table to current",
      "image": "composer-replay-21-query-current.png"
    },
    {
      "id": "22-body-again",
      "title": "回到当前 Text 正文 / Return to the current Text body",
      "image": "composer-replay-22-body-again.png"
    },
    {
      "id": "23-body-current",
      "title": "将正文改为 Hello replay / Change the body to Hello replay",
      "image": "composer-replay-23-body-current.png"
    },
    {
      "id": "24-history",
      "title": "打开 Recent sends 菜单 / Open the Recent sends menu",
      "image": "composer-replay-24-history.png"
    },
    {
      "id": "25-restore-old",
      "title": "选回旧 POST 地址 / Select the earlier POST address",
      "image": "composer-replay-25-restore-old.png"
    },
    {
      "id": "26-current-query",
      "title": "检查 Query 仍为 current 与 again / Check that Query remains current and again",
      "image": "composer-replay-26-current-query.png"
    },
    {
      "id": "27-resend",
      "title": "再次 Send，核对追加的 Query 与当前正文 / Send again and verify appended Query and current body",
      "image": "composer-replay-27-resend.png"
    },
    {
      "id": "28-confirm-body",
      "title": "查看重发后保留的 Text 正文 / Inspect the Text body retained after replay",
      "image": "composer-replay-28-confirm-body.png"
    }
  ],
