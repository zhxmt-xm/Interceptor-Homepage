{
  "chapter": "settings-privacy-export",
  "title": {
    "zh-CN": "逐步骤实操：隐私默认值、单次覆盖和实际HAR字段",
    "en": "Recorded walkthrough: privacy defaults, per-export overrides and actual HAR fields"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "url": "http://127.0.0.1:61384/guide/privacy-export/record",
    "publicAuthorization": "Bearer public-export-value",
    "publicCookie": "guide-request=public",
    "publicResponseCookie": "guide-response=public; Path=/",
    "retainedHeader": "x-guide-note: public-note",
    "originalBody": "{\"message\":\"public privacy example\"}",
    "firstFile": "guide-auth-masked.har",
    "secondFile": "guide-public-unmasked.har",
    "finalFile": "guide-redacted-no-body.har",
    "safety": "All authentication-like values are deliberately public loopback examples, not real credentials",
    "finalDefaults": "Authorization, Cookie and warning enabled; existing files not rewritten"
  },
  "steps": [
    {
      "id": "01-privacy",
      "title": "查看三项Privacy默认值 / Inspect all three Privacy defaults",
      "image": "settings-privacy-export-01-privacy.png"
    },
    {
      "id": "02-auth-default",
      "title": "更改Authorization默认值 / Change the Authorization default",
      "image": "settings-privacy-export-02-auth-default.png"
    },
    {
      "id": "03-cookie-default",
      "title": "更改Cookie默认值 / Change the Cookie default",
      "image": "settings-privacy-export-03-cookie-default.png"
    },
    {
      "id": "04-inherited-export",
      "title": "打开新HAR草稿核对继承 / Open a new HAR draft and verify inherited defaults",
      "image": "settings-privacy-export-04-inherited-export.png"
    },
    {
      "id": "05-one-time-override",
      "title": "本次只遮罩Authorization / Mask Authorization for this export only",
      "image": "settings-privacy-export-05-one-time-override.png"
    },
    {
      "id": "06-save-override",
      "title": "保存guide-auth-masked.har / Save guide-auth-masked.har",
      "image": "settings-privacy-export-06-save-override.png"
    },
    {
      "id": "07-check-override",
      "title": "核对文件只遮罩指定字段 / Verify only the selected fields are masked",
      "image": "settings-privacy-export-07-check-override.png"
    },
    {
      "id": "08-defaults-unchanged",
      "title": "核对单次覆盖没改全局默认值 / Verify the per-export override did not change defaults",
      "image": "settings-privacy-export-08-defaults-unchanged.png"
    },
    {
      "id": "09-warning-default",
      "title": "关闭未遮罩前的警示偏好 / Disable the unmasked-export warning preference",
      "image": "settings-privacy-export-09-warning-default.png"
    },
    {
      "id": "10-unmasked-draft",
      "title": "查看新的公开数据导出草稿 / Inspect the new public-data export draft",
      "image": "settings-privacy-export-10-unmasked-draft.png"
    },
    {
      "id": "11-save-public",
      "title": "只保存本轮公开测试值 / Save only this run’s public example values",
      "image": "settings-privacy-export-11-save-public.png"
    },
    {
      "id": "12-check-public",
      "title": "核对取消遮罩后文件的真实字段 / Verify the actual unmasked exported fields",
      "image": "settings-privacy-export-12-check-public.png"
    },
    {
      "id": "13-restore-privacy",
      "title": "返回Privacy恢复默认值 / Return to Privacy to restore defaults",
      "image": "settings-privacy-export-13-restore-privacy.png"
    },
    {
      "id": "14-restore-auth",
      "title": "恢复Authorization遮罩 / Restore Authorization masking",
      "image": "settings-privacy-export-14-restore-auth.png"
    },
    {
      "id": "15-restore-cookies",
      "title": "恢复Cookie遮罩 / Restore Cookie masking",
      "image": "settings-privacy-export-15-restore-cookies.png"
    },
    {
      "id": "16-restore-warning",
      "title": "恢复未遮罩警示 / Restore the unmasked-export warning",
      "image": "settings-privacy-export-16-restore-warning.png"
    },
    {
      "id": "17-redacted-draft",
      "title": "检查新草稿使用恢复后的默认值 / Inspect a new draft with restored defaults",
      "image": "settings-privacy-export-17-redacted-draft.png"
    },
    {
      "id": "18-strip-bodies",
      "title": "本次移除请求与响应正文 / Remove request and response bodies for this export",
      "image": "settings-privacy-export-18-strip-bodies.png"
    },
    {
      "id": "19-save-redacted",
      "title": "保存guide-redacted-no-body.har / Save guide-redacted-no-body.har",
      "image": "settings-privacy-export-19-save-redacted.png"
    },
    {
      "id": "20-check-redacted",
      "title": "逐字段核对真正的文件内容 / Verify the actual file field by field",
      "image": "settings-privacy-export-20-check-redacted.png"
    },
    {
      "id": "21-clear",
      "title": "清空本轮临时记录再检查导入 / Clear this run’s temporary records before checking import",
      "image": "settings-privacy-export-21-clear.png"
    },
    {
      "id": "22-import",
      "title": "从产品选择刚导出的HAR / Select the just-exported HAR through the product",
      "image": "settings-privacy-export-22-import.png"
    },
    {
      "id": "23-open-redacted",
      "title": "打开本轮去正文HAR / Open this run’s body-stripped HAR",
      "image": "settings-privacy-export-23-open-redacted.png"
    },
    {
      "id": "24-imported",
      "title": "导入不会凭空恢复已移除正文 / Import does not recreate removed body bytes",
      "image": "settings-privacy-export-24-imported.png"
    }
  ],
