  },
  "steps": [
    {
      "id": "01-record",
      "title": "选择本轮临时记录 / Select this run’s temporary record",
      "image": "settings-storage-privacy-01-record.png"
    },
    {
      "id": "02-privacy",
      "title": "打开隐私默认值 / Open privacy defaults",
      "image": "settings-storage-privacy-02-privacy.png"
    },
    {
      "id": "03-cookie-default",
      "title": "临时更改 Cookie 默认值 / Temporarily change the Cookie default",
      "image": "settings-storage-privacy-03-cookie-default.png"
    },
    {
      "id": "04-new-export",
      "title": "打开新的 HAR 导出检查继承 / Open a new HAR export and check defaults",
      "image": "settings-storage-privacy-04-new-export.png"
    },
    {
      "id": "05-filter-scope",
      "title": "选择当前筛选范围 / Select the current filter scope",
      "image": "settings-storage-privacy-05-filter-scope.png"
    },
    {
      "id": "06-all-scope",
      "title": "查看全部记录范围 / Inspect the all-records scope",
      "image": "settings-storage-privacy-06-all-scope.png"
    },
    {
      "id": "07-one-export-override",
      "title": "只覆盖本次 Cookie 遮罩 / Override Cookie masking for this export",
      "image": "settings-storage-privacy-07-one-export-override.png"
    },
    {
      "id": "08-cancel-export",
      "title": "取消本次导出 / Cancel this export",
      "image": "settings-storage-privacy-08-cancel-export.png"
    },
    {
      "id": "09-default-unchanged",
      "title": "确认单次覆盖没有改默认值 / Verify the override did not change defaults",
      "image": "settings-storage-privacy-09-default-unchanged.png"
    },
    {
      "id": "10-restore-privacy",
      "title": "恢复 Cookie 遮罩默认值 / Restore the Cookie masking default",
      "image": "settings-storage-privacy-10-restore-privacy.png"
    },
    {
      "id": "11-storage",
      "title": "查看实际存储用量 / Inspect actual storage usage",
      "image": "settings-storage-privacy-11-storage.png"
    },
    {
      "id": "12-refresh",
      "title": "Refresh 只刷新统计 / Refresh updates statistics only",
      "image": "settings-storage-privacy-12-refresh.png"
    },
    {
      "id": "13-clear-dialog",
      "title": "检查 Clear 影响 / Review Clear effects",
      "image": "settings-storage-privacy-13-clear-dialog.png"
    },
    {
      "id": "14-cancel-clear",
      "title": "取消 Clear 不删除记录 / Cancel Clear without deleting records",
      "image": "settings-storage-privacy-14-cancel-clear.png"
    },
    {
      "id": "15-confirm-clear",
      "title": "确认清理本轮记录和正文 / Confirm clearing this run’s records and bodies",
      "image": "settings-storage-privacy-15-confirm-clear.png"
    },
    {
      "id": "16-empty-capture",
      "title": "Capture 同步变空且仍暂停 / Capture is empty and remains paused",
      "image": "settings-storage-privacy-16-empty-capture.png"
    },
    {
      "id": "17-resume-after-clear",
      "title": "Clear 后显式恢复录制 / Explicitly resume after Clear",
      "image": "settings-storage-privacy-17-resume-after-clear.png"
    },
    {
      "id": "18-new-record",
      "title": "Clear 后捕获新请求 / Capture a new request after Clear",
      "image": "settings-storage-privacy-18-new-record.png"
    }
  ],
