  "example": {
    "folders": "Guide persistence 1 > Guide persistence 2 > Guide persistence 3",
    "requestName": "Guide persisted fields",
    "url": "http://127.0.0.1:49253/guide/persisted-request?guide=url",
    "method": "POST",
    "protocol": "http/1.1",
    "expectedPath": "/guide/persisted-request?guide=url&scope=retained",
    "body": "{\"message\":\"persisted-fields\",\"count\":2}",
    "enabledHeader": "x-guide-persist: retained",
    "disabledHeader": "x-guide-disabled: omitted",
    "publicToken": "public-persistence-example",
    "sentAfterRestart": "One explicit UI Send; no automatic replay",
    "evidenceGeneration": "composer-reopened"
  },
  "steps": [
    {
      "id": "01-folder-1",
