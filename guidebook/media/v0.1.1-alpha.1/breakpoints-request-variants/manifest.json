  "example": {
    "ruleName": "Guide request variants",
    "path": "/guide/request-variants",
    "originalRequest": "{\"message\":\"guide-original-request\"}",
    "requestHeader": "x-guide-request: header-only",
    "jsonFile": "guide-request.json",
    "jsonFileBody": "{\"message\":\"guide-file-request\",\"count\":2}",
    "binaryFile": "guide-request.bin",
    "binaryHex": "00010203feff",
    "responseStatus": "202",
    "retainedResponseBody": "{\"message\":\"guide-origin-response\"}",
    "binaryPreview": "The release shows file metadata without a text preview; forwarding still sends all six bytes",
    "httpSnapshot": "HTTP suspension is at the head stage; Capture may independently provide a readable original preview",
    "source": "Both replacement files are generated by this workflow’s real Save body"
  },
