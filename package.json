{
  "name": "@interceptor/homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interceptor product website",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "playwright test",
    "check": "npm run lint && npm test",
    "preview:cloudflare": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
