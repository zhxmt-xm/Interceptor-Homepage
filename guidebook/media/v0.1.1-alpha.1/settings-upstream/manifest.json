{
  "chapter": "settings-upstream",
  "title": {
    "zh-CN": "逐步骤实操：Manual、PAC、Direct与共享草稿",
    "en": "Recorded walkthrough: Manual, PAC, Direct and shared drafts"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "origin": "http://127.0.0.1:51204/guide/upstream",
    "proxyHost": "127.0.0.1",
    "proxyPort": "51206",
    "pacUrl": "http://127.0.0.1:51204/guide/upstream/route.pac",
    "pacChoice": "127.0.0.1 uses the owned PROXY; localhost uses DIRECT",
    "draftBoundary": "Cancel/Discard do not Apply; Open in Settings retains the same draft",
    "finalMode": "system",
    "scope": "Owned HTTP routes only; no WPAD, external credentials or system proxy preference writes"
  },
  "steps": [
    {
      "id": "01-settings",
      "title": "打开Settings / Open Settings",
      "image": "settings-upstream-01-settings.png"
    },
    {
      "id": "02-upstream",
      "title": "打开Upstream proxy / Open Upstream proxy",
      "image": "settings-upstream-02-upstream.png"
    },
    {
      "id": "03-direct-draft",
      "title": "选择Direct草稿 / Select a Direct draft",
      "image": "settings-upstream-03-direct-draft.png"
    },
    {
      "id": "04-discard",
      "title": "Discard草稿不改路线 / Discard the draft without changing the route",
      "image": "settings-upstream-04-discard.png"
    },
    {
      "id": "05-manual",
      "title": "选择Manual / Select Manual",
      "image": "settings-upstream-05-manual.png"
    },
    {
      "id": "06-host",
      "title": "填写自有上游Host / Enter the owned upstream Host",
      "image": "settings-upstream-06-host.png"
    },
    {
      "id": "07-port",
      "title": "填写实际上游端口 / Enter the actual upstream port",
      "image": "settings-upstream-07-port.png"
    },
    {
      "id": "08-apply-manual",
      "title": "Apply Manual / Apply Manual",
      "image": "settings-upstream-08-apply-manual.png"
    },
    {
      "id": "09-manual-request",
      "title": "用真实转发核对Manual / Verify Manual through actual forwarding",
      "image": "settings-upstream-09-manual-request.png"
    },
    {
      "id": "10-capture",
      "title": "返回Capture查看生效路线 / Return to Capture to inspect the active route",
      "image": "settings-upstream-10-capture.png"
    },
    {
      "id": "11-shortcut",
      "title": "打开底栏快捷浮层 / Open the statusbar popover",
      "image": "settings-upstream-11-shortcut.png"
    },
    {
      "id": "12-pac-draft",
      "title": "在浮层选择PAC草稿 / Select a PAC draft in the popover",
      "image": "settings-upstream-12-pac-draft.png"
    },
    {
      "id": "13-pac-url",
      "title": "填写自有PAC地址 / Enter the owned PAC URL",
      "image": "settings-upstream-13-pac-url.png"
    },
    {
      "id": "14-cancel-draft",
      "title": "Cancel放弃本次浮层草稿 / Cancel this popover draft",
      "image": "settings-upstream-14-cancel-draft.png"
    },
    {
      "id": "15-reopen",
      "title": "重开浮层核对仍为Manual / Reopen and verify Manual remains",
      "image": "settings-upstream-15-reopen.png"
    },
    {
      "id": "16-pac-again",
      "title": "重新选择PAC / Select PAC again",
      "image": "settings-upstream-16-pac-again.png"
    },
    {
      "id": "17-pac-url-again",
      "title": "再次填写本轮PAC / Enter this run’s PAC again",
      "image": "settings-upstream-17-pac-url-again.png"
    },
    {
      "id": "18-open-settings",
      "title": "把同一草稿带到Settings / Carry the same draft into Settings",
      "image": "settings-upstream-18-open-settings.png"
    },
    {
      "id": "19-apply-pac",
      "title": "Apply PAC / Apply PAC",
      "image": "settings-upstream-19-apply-pac.png"
    },
    {
      "id": "20-pac-proxy",
      "title": "核对PAC选择PROXY / Verify PAC selects PROXY",
      "image": "settings-upstream-20-pac-proxy.png"
    },
    {
      "id": "21-pac-direct",
      "title": "核对同一PAC选择DIRECT / Verify the same PAC selects DIRECT",
      "image": "settings-upstream-21-pac-direct.png"
    },
    {
      "id": "22-direct",
      "title": "显式选择Direct / Select Direct explicitly",
      "image": "settings-upstream-22-direct.png"
    },
    {
      "id": "23-apply-direct",
      "title": "Apply Direct / Apply Direct",
      "image": "settings-upstream-23-apply-direct.png"
    },
    {
      "id": "24-direct-request",
      "title": "核对Direct不经过上游 / Verify Direct bypasses the upstream",
      "image": "settings-upstream-24-direct-request.png"
    },
    {
      "id": "25-system",
      "title": "恢复System选择 / Restore the System selection",
      "image": "settings-upstream-25-system.png"
    },
    {
      "id": "26-apply-system",
      "title": "Apply System / Apply System",
      "image": "settings-upstream-26-apply-system.png"
    }
  ],
