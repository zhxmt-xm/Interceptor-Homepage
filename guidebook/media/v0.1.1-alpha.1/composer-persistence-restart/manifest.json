      "image": "composer-persistence-restart-01-folder-3.png"
    },
    {
      "id": "02-select",
      "title": "打开同一个保存请求 / Open the same saved request",
      "image": "composer-persistence-restart-02-select.png"
    },
    {
      "id": "03-headers",
      "title": "核对Header值与启停状态 / Verify Header values and enabled states",
      "image": "composer-persistence-restart-03-headers.png"
    },
    {
      "id": "04-query",
      "title": "核对未重填的Query行 / Verify the Query row without refilling it",
      "image": "composer-persistence-restart-04-query.png"
    },
    {
      "id": "05-body",
      "title": "核对实际回载的JSON正文 / Verify the actually restored JSON body",
      "image": "composer-persistence-restart-05-body.png"
    },
    {
      "id": "06-auth",
      "title": "核对实际回载的公开Auth字段 / Verify the restored public Auth field",
      "image": "composer-persistence-restart-06-auth.png"
    },
    {
      "id": "07-send",
      "title": "仅在重启后Send一次核对实际字节 / Send once after restart and verify actual bytes",
      "image": "composer-persistence-restart-07-send.png"
    },
    {
      "id": "08-clear-auth",
      "title": "清空演示Auth值 / Clear the demonstration Auth value",
      "image": "composer-persistence-restart-08-clear-auth.png"
    },
    {
      "id": "09-none",
      "title": "恢复Auth None并等待保存 / Restore Auth None and wait for saving",
      "image": "composer-persistence-restart-09-none.png"
    }
