    "zh-CN": "逐步骤实操：隐私默认值、存储取消与清理",
    "en": "Recorded walkthrough: privacy defaults, cancelling and clearing storage"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
