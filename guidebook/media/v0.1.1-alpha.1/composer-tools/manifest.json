{
  "chapter": "composer-tools",
  "title": {
    "zh-CN": "逐步骤实操：MCP发送审批与Collection读取替换",
    "en": "Recorded walkthrough: MCP send approval and Collection read/replace"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "caller": "Official local SDK; not a commercial Host interface",
    "clientName": "Guide Composer tools",
    "endpoint": "http://127.0.0.1:52619/mcp",
    "originalName": "Guide UI request",
    "replacedName": "Guide MCP renamed request",
    "savedUrl": "http://127.0.0.1:52615/guide/composer-tools/saved",
    "sentUrl": "http://127.0.0.1:52615/guide/composer-tools/allowed",
    "uiResponse": "guide-ui-response",
    "toolResponse": "{\"message\":\"guide-tool-response\"}",
    "method": "POST",
    "requestBody": "{\"message\":\"guide-tool-request\"}",
    "requestHeader": "x-guide-tool: public-example",
    "collectionHeader": "x-guide-collection: public-example",
    "protocol": "http/1.1",
    "timeoutMs": "5000",
    "originalRevision": "4",
    "finalRevision": "5",
    "uiBoundary": "Tool sending returns to its caller; Collection replacement notifies the mounted Composer UI"
  },
  "steps": [
    {
      "id": "01-ask-client",
      "title": "检查本次Client的Ask模式 / Inspect Ask for this Client",
      "image": "composer-tools-01-ask-client.png"
    },
    {
      "id": "02-composer",
      "title": "打开Composer / Open Composer",
      "image": "composer-tools-02-composer.png"
    },
    {
      "id": "03-create",
      "title": "新建本次Collection请求 / Create this Collection request",
      "image": "composer-tools-03-create.png"
    },
    {
      "id": "04-rename-menu",
      "title": "打开请求的重命名入口 / Open the request rename action",
      "image": "composer-tools-04-rename-menu.png"
    },
    {
      "id": "05-name",
      "title": "保存名称Guide UI request / Save the name Guide UI request",
      "image": "composer-tools-05-name.png"
    },
    {
      "id": "06-url",
      "title": "填写本次自有UI请求地址 / Enter the owned UI request URL",
      "image": "composer-tools-06-url.png"
    },
    {
      "id": "07-header",
      "title": "添加公开示例Header / Add the public example Header",
      "image": "composer-tools-07-header.png"
    },
    {
      "id": "08-ui-send",
      "title": "通过UI Send读取guide-ui-response / Send through UI and read guide-ui-response",
      "image": "composer-tools-08-ui-send.png"
    },
    {
      "id": "09-saved",
      "title": "等待Collection实际保存 / Wait for the Collection to be saved",
      "image": "composer-tools-09-saved.png"
    },
    {
      "id": "10-query",
      "title": "只读获取实际保存的Collection / Query the actually saved Collection",
      "image": "composer-tools-10-query.png"
    },
    {
      "id": "11-send-ask",
      "title": "检查Composer发送的实际审批 / Inspect the actual Composer send approval",
      "image": "composer-tools-11-send-ask.png"
    },
    {
      "id": "12-send-deny",
      "title": "Deny不发送网络请求 / Deny without sending a network request",
      "image": "composer-tools-12-send-deny.png"
    },
    {
      "id": "13-send-again",
      "title": "重新请求同一个明确目标 / Request the same explicit destination again",
      "image": "composer-tools-13-send-again.png"
    },
    {
      "id": "14-send-allow",
      "title": "Allow后核对真实POST与201结果 / Allow and verify the real POST and 201 result",
      "image": "composer-tools-14-send-allow.png"
    },
    {
      "id": "15-ui-response-kept",
      "title": "Tool结果不替换当前UI响应 / Tool results do not replace the current UI response",
      "image": "composer-tools-15-ui-response-kept.png"
    },
    {
      "id": "16-replace-ask",
      "title": "检查Collection替换的实际范围 / Inspect the actual Collection replacement scope",
      "image": "composer-tools-16-replace-ask.png"
    },
    {
      "id": "17-replace-deny",
      "title": "Deny保留原Collection / Deny and retain the original Collection",
      "image": "composer-tools-17-replace-deny.png"
    },
    {
      "id": "18-replace-again",
      "title": "用同一已读取版本重新请求 / Request replacement from the same read revision again",
      "image": "composer-tools-18-replace-again.png"
    },
    {
      "id": "19-replace-allow",
      "title": "Allow后查看当前UI自动同步 / Allow and observe notification-driven UI synchronization",
      "image": "composer-tools-19-replace-allow.png"
    },
    {
      "id": "20-query-latest",
      "title": "重新读取最终保存版本 / Query the final saved revision",
      "image": "composer-tools-20-query-latest.png"
    },
    {
      "id": "21-mcp-settings",
      "title": "回到本次MCP设置 / Return to this MCP configuration",
      "image": "composer-tools-21-mcp-settings.png"
    },
    {
      "id": "22-disable",
      "title": "关闭演示Client连接与Server / Close the demo Client connection and Server",
      "image": "composer-tools-22-disable.png"
    }
  ],
