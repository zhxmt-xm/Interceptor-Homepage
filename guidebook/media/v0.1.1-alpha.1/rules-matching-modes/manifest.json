{
  "chapter": "rules-matching-modes",
  "title": {
    "zh-CN": "逐步骤实操：包含、精确、正则、大小写与MIME匹配",
    "en": "Recorded walkthrough: contains, exact, regex, case and MIME matching"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "ruleName": "Guide matching modes",
    "host": "127.0.0.1",
    "path": "/guide/matching/Case",
    "header": "x-guide-mode: matched",
    "containsInput": "/guide/matching/case/extra",
    "exactInput": "/guide/matching/Case",
    "regex": "^/guide/matching/[A-Z]+$",
    "regexUpper": "/guide/matching/READY",
    "regexLower": "/guide/matching/ready",
    "mime": "application/*",
    "positiveMime": "application/json",
    "negativeMime": "text/plain",
    "invalidRegex": "[",
    "invalidRegexLimit": "This release permits Apply but the invalid regex never matches; fix the expression rather than trusting the applied label"
  },
