  "steps": [
    {
      "id": "01-request",
      "title": "创建并命名本轮请求 / Create and name this request",
      "image": "composer-file-tools-01-request.png"
    },
    {
      "id": "02-url",
      "title": "填写本轮公开测试地址 / Enter the public test URL",
      "image": "composer-file-tools-02-url.png"
    },
    {
      "id": "03-header",
      "title": "保存公开Header但不Send / Save a public Header without sending",
      "image": "composer-file-tools-03-header.png"
    },
    {
      "id": "04-export-ask",
      "title": "检查Collection Export审批 / Inspect Collection Export approval",
      "image": "composer-file-tools-04-export-ask.png"
    },
    {
      "id": "05-export-deny",
      "title": "Deny不写出文件 / Deny without writing a file",
      "image": "composer-file-tools-05-export-deny.png"
    },
    {
      "id": "06-export-cancel-ask",
      "title": "再次请求Export并Allow / Request Export again and allow it",
      "image": "composer-file-tools-06-export-cancel-ask.png"
    },
    {
      "id": "07-save-cancel-panel",
      "title": "在自有目录查看Save面板 / Inspect Save in the owned directory",
      "image": "composer-file-tools-07-save-cancel-panel.png"
    },
    {
      "id": "08-save-cancelled",
      "title": "取消原生Save后没有导出 / Native Save cancellation does not export",
      "image": "composer-file-tools-08-save-cancelled.png"
    },
    {
      "id": "09-export-save-ask",
      "title": "请求真正保存的Export / Request the Export to save",
      "image": "composer-file-tools-09-export-save-ask.png"
    },
    {
      "id": "10-save-file",
      "title": "保存guide-tool-collection.json / Save guide-tool-collection.json",
      "image": "composer-file-tools-10-save-file.png"
    },
    {
      "id": "11-export-result",
      "title": "检查产品实际导出的文件 / Inspect the file actually exported by the product",
      "image": "composer-file-tools-11-export-result.png"
    },
    {
      "id": "12-import-deny-ask",
      "title": "检查Import自己的审批 / Inspect the separate Import approval",
      "image": "composer-file-tools-12-import-deny-ask.png"
    },
    {
      "id": "13-import-denied",
      "title": "Deny不导入Collection / Deny without importing the Collection",
      "image": "composer-file-tools-13-import-denied.png"
    },
    {
      "id": "14-open-cancel-ask",
      "title": "Allow后仍需要Open面板 / Allow still requires an Open panel",
      "image": "composer-file-tools-14-open-cancel-ask.png"
    },
    {
      "id": "15-open-cancel-panel",
      "title": "只选择本流程导出的文件 / Select only this flow’s exported file",
      "image": "composer-file-tools-15-open-cancel-panel.png"
    },
    {
      "id": "16-open-cancelled",
      "title": "取消Open保留原集合 / Cancel Open and retain the original Collection",
      "image": "composer-file-tools-16-open-cancelled.png"
    },
    {
      "id": "cancel-preview-ask",
      "title": "再次检查Import审批 / Review Import approval again",
      "image": "composer-file-tools-cancel-preview-ask.png"
    },
    {
      "id": "cancel-preview-open",
      "title": "打开同一份产品文件 / Open the same product-created file",
      "image": "composer-file-tools-cancel-preview-open.png"
    },
    {
      "id": "cancel-preview-preview",
      "title": "读取真实导入预览 / Read the actual import preview",
      "image": "composer-file-tools-cancel-preview-preview.png"
    },
    {
      "id": "cancel-preview-decision",
      "title": "取消预览不修改集合 / Cancel preview without changing the Collection",
      "image": "composer-file-tools-cancel-preview-decision.png"
    },
    {
      "id": "confirm-preview-ask",
      "title": "再次检查Import审批 / Review Import approval again",
      "image": "composer-file-tools-confirm-preview-ask.png"
    },
    {
      "id": "confirm-preview-open",
      "title": "打开同一份产品文件 / Open the same product-created file",
      "image": "composer-file-tools-confirm-preview-open.png"
    },
    {
      "id": "confirm-preview-preview",
      "title": "读取真实导入预览 / Read the actual import preview",
      "image": "composer-file-tools-confirm-preview-preview.png"
    },
    {
      "id": "confirm-preview-decision",
      "title": "确认追加而不覆盖原请求 / Confirm append without replacing the original request",
      "image": "composer-file-tools-confirm-preview-decision.png"
    },
    {
      "id": "auto-mode",
      "title": "为本轮重复导入选择Auto / Select Auto for this repeated import",
      "image": "composer-file-tools-auto-mode.png"
    },
    {
      "id": "auto-open",
      "title": "Auto仍使用真实Open / Auto still uses native Open",
      "image": "composer-file-tools-auto-open.png"
    },
    {
      "id": "auto-preview",
      "title": "Auto仍等待产品预览确认 / Auto still waits for product preview confirmation",
      "image": "composer-file-tools-auto-preview.png"
    },
    {
      "id": "auto-confirm",
      "title": "确认第二次追加并检查独立身份 / Confirm the second append and check distinct identities",
      "image": "composer-file-tools-auto-confirm.png"
    },
    {
      "id": "stop-server",
      "title": "关闭本轮MCP Server / Disable this run’s MCP Server",
      "image": "composer-file-tools-stop-server.png"
    }
  ],
