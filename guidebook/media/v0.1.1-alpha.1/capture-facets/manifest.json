{
  "chapter": "capture-facets",
  "title": {
    "zh-CN": "逐步骤实操：Application、Host、Protocol、Type与Rule筛选",
    "en": "Recorded walkthrough: Application, Host, Protocol, Type and Rule filters"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
