{
  "chapter": "settings-tls-passthrough",
  "title": {
    "zh-CN": "逐步骤实操：TLS 透传与恢复解密",
    "en": "Recorded walkthrough: TLS passthrough and restored decryption"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "host": "localhost",
    "filter": "localhost",
    "url": "https://localhost:63604/playground/tls/h1",
    "originPort": "63604",
    "originException": "localhost (owned self-signed test origin; removed after recording)",
    "passthrough": "localhost (exact host; removed before reconnecting)",
    "certificateScope": "existing trusted CA; no generation, install, uninstall or deletion"
  },
  "steps": [
    {
      "id": "01-filter",
      "title": "按 localhost 筛选 / Filter by localhost",
      "image": "settings-tls-passthrough-01-filter.png"
    },
    {
      "id": "02-record",
      "title": "开启 Recording / Start Recording",
      "image": "settings-tls-passthrough-02-record.png"
    },
    {
      "id": "03-opaque-request",
      "title": "建立未解密 TLS 连接 / Establish an opaque TLS connection",
      "image": "settings-tls-passthrough-03-opaque-request.png"
    },
    {
      "id": "04-tunnel-select",
      "title": "选择 CONNECT 隧道 / Select the CONNECT tunnel",
      "image": "settings-tls-passthrough-04-tunnel-select.png"
    },
    {
      "id": "05-tunnel",
      "title": "查看 Tunnel 而非 HTTP 正文 / Inspect Tunnel rather than an HTTP body",
      "image": "settings-tls-passthrough-05-tunnel.png"
    },
    {
      "id": "06-https-setup",
      "title": "从 Tunnel 打开 HTTPS Setup / Open HTTPS Setup from Tunnel",
      "image": "settings-tls-passthrough-06-https-setup.png"
    },
    {
      "id": "07-cancel-setup",
      "title": "取消且保持未解密 / Cancel without enabling decryption",
      "image": "settings-tls-passthrough-07-cancel-setup.png"
    },
    {
      "id": "08-settings",
      "title": "打开 Settings / Open Settings",
      "image": "settings-tls-passthrough-08-settings.png"
    },
    {
      "id": "09-certificates",
      "title": "检查已有受信任 CA / Inspect the existing trusted CA",
      "image": "settings-tls-passthrough-09-certificates.png"
    },
    {
      "id": "10-origin-host",
      "title": "填写自有源站 localhost / Enter the owned origin localhost",
      "image": "settings-tls-passthrough-10-origin-host.png"
    },
    {
      "id": "11-origin-add",
      "title": "仅添加本轮源站例外 / Add only this run’s origin exception",
      "image": "settings-tls-passthrough-11-origin-add.png"
    },
    {
      "id": "12-mitm-on",
      "title": "开启 HTTPS 解密 / Enable HTTPS decryption",
      "image": "settings-tls-passthrough-12-mitm-on.png"
    },
    {
      "id": "13-capture-decrypted",
      "title": "返回 Capture / Return to Capture",
      "image": "settings-tls-passthrough-13-capture-decrypted.png"
    },
    {
      "id": "14-decrypted-request",
      "title": "用新连接请求 HTTPS / Request HTTPS over a new connection",
      "image": "settings-tls-passthrough-14-decrypted-request.png"
    },
    {
      "id": "15-decrypted-select",
      "title": "选择解密后的 GET / Select the decrypted GET",
      "image": "settings-tls-passthrough-15-decrypted-select.png"
    },
    {
      "id": "16-decrypted-body",
      "title": "读取真实 HTTPS 正文 / Read the actual HTTPS body",
      "image": "settings-tls-passthrough-16-decrypted-body.png"
    },
    {
      "id": "17-settings-passthrough",
      "title": "返回 Settings / Return to Settings",
      "image": "settings-tls-passthrough-17-settings-passthrough.png"
    },
    {
      "id": "18-passthrough",
      "title": "打开 TLS passthrough / Open TLS passthrough",
      "image": "settings-tls-passthrough-18-passthrough.png"
    },
    {
      "id": "19-host",
      "title": "填写精确主机 localhost / Enter the exact host localhost",
      "image": "settings-tls-passthrough-19-host.png"
    },
    {
      "id": "20-add",
      "title": "添加并保存透传条目 / Add and save the passthrough entry",
      "image": "settings-tls-passthrough-20-add.png"
    },
    {
      "id": "21-capture-passthrough",
      "title": "返回 Capture 检查新连接 / Return to Capture to inspect a new connection",
      "image": "settings-tls-passthrough-21-capture-passthrough.png"
    },
    {
      "id": "22-passthrough-request",
      "title": "重新建立同一源站 HTTPS 连接 / Reconnect to the same HTTPS origin",
      "image": "settings-tls-passthrough-22-passthrough-request.png"
    },
    {
      "id": "23-passthrough-select",
      "title": "选择新增 CONNECT / Select the new CONNECT tunnel",
      "image": "settings-tls-passthrough-23-passthrough-select.png"
    },
    {
      "id": "24-passthrough-tunnel",
      "title": "核对命中 TLS passthrough / Verify the TLS passthrough match",
      "image": "settings-tls-passthrough-24-passthrough-tunnel.png"
    },
    {
      "id": "25-locate",
      "title": "从 Tunnel 定位实际名单条目 / Locate the actual entry from Tunnel",
      "image": "settings-tls-passthrough-25-locate.png"
    },
    {
      "id": "26-remove",
      "title": "删除本轮 localhost 透传项 / Remove this run’s localhost passthrough entry",
      "image": "settings-tls-passthrough-26-remove.png"
    },
    {
      "id": "27-capture-restored",
      "title": "返回 Capture 检查恢复 / Return to Capture to inspect restoration",
      "image": "settings-tls-passthrough-27-capture-restored.png"
    },
    {
      "id": "28-reconnect",
      "title": "再次用新连接请求 HTTPS / Request HTTPS over another new connection",
      "image": "settings-tls-passthrough-28-reconnect.png"
    },
    {
      "id": "29-restored-select",
      "title": "选择恢复解密的 GET / Select the newly decrypted GET",
      "image": "settings-tls-passthrough-29-restored-select.png"
    },
    {
      "id": "30-restored-body",
      "title": "核对 HTTP 正文恢复 / Verify the HTTP body is visible again",
      "image": "settings-tls-passthrough-30-restored-body.png"
    },
    {
      "id": "31-cleanup-settings",
      "title": "返回 Settings 清理本轮配置 / Return to Settings to restore this run’s configuration",
      "image": "settings-tls-passthrough-31-cleanup-settings.png"
    },
    {
      "id": "32-cleanup-certificates",
      "title": "打开 Certificates / Open Certificates",
      "image": "settings-tls-passthrough-32-cleanup-certificates.png"
    },
    {
      "id": "33-mitm-off",
      "title": "关闭本轮解密 / Disable this run’s decryption",
      "image": "settings-tls-passthrough-33-mitm-off.png"
    },
    {
      "id": "34-origin-remove",
      "title": "移除自有源站例外 / Remove the owned origin exception",
      "image": "settings-tls-passthrough-34-origin-remove.png"
    }
  ],
