{
  "chapter": "capture-grpc-messages",
  "title": {
    "zh-CN": "逐步骤实操：gRPC消息正文、复制、全屏与分页",
    "en": "Recorded walkthrough: gRPC message bodies, copying, fullscreen and paging"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "protocol": "grpc",
    "filter": "/guide/messages/grpc",
    "detailPath": "/guide/messages/grpc/detail",
    "pagePath": "/guide/messages/grpc/pages",
    "firstMessage": "{\"message\":\"guide-short\",\"state\":\"ready\"}",
    "longMessage": "guide-long with 28 entries; ending guide-message-end",
    "firstCount": "6",
    "pagedCount": "205",
    "finalMessage": "{\"index\":204,\"message\":\"guide-page-204\"}",
    "detailEncoding": "gRPC JSON",
    "pagedEncoding": "gRPC JSON",
    "tlsScope": "existing CA; localhost exception removed, decryption stopped"
  },
  "steps": [
    {
      "id": "01-filter",
      "title": "限定本轮消息路径 / Scope this run’s message paths",
      "image": "capture-grpc-messages-01-filter.png"
    },
    {
      "id": "02-record",
      "title": "开启 Recording / Start Recording",
      "image": "capture-grpc-messages-02-record.png"
    },
    {
      "id": "03-messages",
      "title": "发送六条公开消息 / Send six public messages",
      "image": "capture-grpc-messages-03-messages.png"
    },
    {
      "id": "04-select",
      "title": "选择本轮连接 / Select this run’s connection",
      "image": "capture-grpc-messages-04-select.png"
    },
    {
      "id": "05-tab",
      "title": "打开消息页 / Open the messages tab",
      "image": "capture-grpc-messages-05-tab.png"
    },
    {
      "id": "06-direction",
      "title": "选择 Response 消息 / Select response messages",
      "image": "capture-grpc-messages-06-direction.png"
    },
    {
      "id": "07-short",
      "title": "展开 guide-short / Expand guide-short",
      "image": "capture-grpc-messages-07-short.png"
    },
    {
      "id": "08-short-raw",
      "title": "选择 Raw 查看原文 / Select Raw to inspect the text",
      "image": "capture-grpc-messages-08-short-raw.png"
    },
    {
      "id": "09-copy-short",
      "title": "复制当前短消息正文 / Copy the current short message body",
      "image": "capture-grpc-messages-09-copy-short.png"
    },
    {
      "id": "10-collapse-short",
      "title": "收起短消息 / Collapse the short message",
      "image": "capture-grpc-messages-10-collapse-short.png"
    },
    {
      "id": "11-long",
      "title": "展开 guide-long / Expand guide-long",
      "image": "capture-grpc-messages-11-long.png"
    },
    {
      "id": "12-resize",
      "title": "拖动正文右下角缩小高度 / Drag the body corner to reduce its height",
      "image": "capture-grpc-messages-12-resize.png"
    },
    {
      "id": "13-wheel",
      "title": "在长消息中滚动 / Scroll inside the long message",
      "image": "capture-grpc-messages-13-wheel.png"
    },
    {
      "id": "14-keyboard-end",
      "title": "用键盘到达消息末尾 / Reach the message end with the keyboard",
      "image": "capture-grpc-messages-14-keyboard-end.png"
    },
    {
      "id": "15-scroll-out",
      "title": "到底后继续滚动消息列表 / Continue scrolling the list at the body boundary",
      "image": "capture-grpc-messages-15-scroll-out.png"
    },
    {
      "id": "16-copy-long",
      "title": "复制完整长消息正文 / Copy the complete long message body",
      "image": "capture-grpc-messages-16-copy-long.png"
    },
    {
      "id": "17-payload-copy",
      "title": "使用消息专用 Copy / Use the message-specific Copy",
      "image": "capture-grpc-messages-17-payload-copy.png"
    },
    {
      "id": "18-fullscreen",
      "title": "全屏查看这条消息 / View this message fullscreen",
      "image": "capture-grpc-messages-18-fullscreen.png"
    },
    {
      "id": "19-return",
      "title": "Escape 返回同一消息 / Return to the same message with Escape",
      "image": "capture-grpc-messages-19-return.png"
    },
    {
      "id": "20-paged-input",
      "title": "在新连接发送205条消息 / Send 205 messages on a new connection",
      "image": "capture-grpc-messages-20-paged-input.png"
    },
    {
      "id": "21-paged-select",
      "title": "选择新的 pages 连接 / Select the new pages connection",
      "image": "capture-grpc-messages-21-paged-select.png"
    },
    {
      "id": "22-paged-tab",
      "title": "打开新连接的消息 / Open messages for the new connection",
      "image": "capture-grpc-messages-22-paged-tab.png"
    },
    {
      "id": "23-load-pages",
      "title": "滚动加载后续消息页 / Scroll to load subsequent message pages",
      "image": "capture-grpc-messages-23-load-pages.png"
    },
    {
      "id": "24-last-message",
      "title": "展开第205条消息 / Expand message 205",
      "image": "capture-grpc-messages-24-last-message.png"
    },
    {
      "id": "24a-last-raw",
      "title": "切到 Raw 查看末条原文 / Switch to Raw for the last message text",
      "image": "capture-grpc-messages-24a-last-raw.png"
    },
    {
      "id": "24b-last-visible",
      "title": "继续滚动使末条正文完整可见 / Continue scrolling to show the whole last message",
      "image": "capture-grpc-messages-24b-last-visible.png"
    },
    {
      "id": "25-copy-last",
      "title": "复制最后一条并核对 index 204 / Copy the last message and verify index 204",
      "image": "capture-grpc-messages-25-copy-last.png"
    },
    {
      "id": "26-settings",
      "title": "返回 Settings / Return to Settings",
      "image": "capture-grpc-messages-26-settings.png"
    },
    {
      "id": "27-certificates",
      "title": "打开 Certificates / Open Certificates",
      "image": "capture-grpc-messages-27-certificates.png"
    },
    {
      "id": "28-mitm-off",
      "title": "关闭本轮解密 / Disable this run’s decryption",
      "image": "capture-grpc-messages-28-mitm-off.png"
    },
    {
      "id": "29-origin-remove",
      "title": "移除自有localhost例外 / Remove the owned localhost exception",
      "image": "capture-grpc-messages-29-origin-remove.png"
    }
  ],
