    "requestName": "Guide file request",
    "url": "http://127.0.0.1:65022/guide/collection-file-tools",
    "header": "x-guide-file: public-collection",
    "exportedFile": "guide-tool-collection.json",
    "cancelledFile": "guide-cancelled-collection.json",
    "sourceOfImport": "The same file exported by the product in this workflow",
