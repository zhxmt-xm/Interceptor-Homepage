{
  "chapter": "composer-persistence-restart",
  "title": {
    "zh-CN": "逐步骤实操：真实重启后核对字段并发送",
    "en": "Recorded walkthrough: verifying fields and sending after a real restart"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
