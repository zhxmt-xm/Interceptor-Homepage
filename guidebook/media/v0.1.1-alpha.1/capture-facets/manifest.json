  "example": {
    "search": "/guide/facets",
    "ruleName": "Guide facets",
    "rulePath": "/guide/facets/selected-json",
    "host": "127.0.0.1",
    "protocol": "HTTP/1.1",
    "application": "Unknown (actual macOS result, not Windows attribution)",
    "prerequisite": "Two captured owned requests and one applied Guide facets Rule; recording is paused before filming",
    "jsonPath": "/guide/facets/selected-json",
    "textPath": "/guide/facets/other-text",
    "header": "x-guide-facet: selected",
    "initialRecords": "2",
    "afterJson": "1",
    "afterRule": "1",
    "afterClearFacets": "2"
  },
  "steps": [
    {
      "id": "01-application",
      "title": "展开 Application / Expand Application",
      "image": "capture-facets-01-application.png"
    },
    {
      "id": "02-unknown",
      "title": "选择本次 Unknown 归属 / Select this run’s Unknown attribution",
      "image": "capture-facets-02-unknown.png"
    },
    {
      "id": "03-host-group",
      "title": "展开 Host / Expand Host",
      "image": "capture-facets-03-host-group.png"
    },
    {
      "id": "04-host-select",
      "title": "选择 127.0.0.1 / Select 127.0.0.1",
      "image": "capture-facets-04-host-select.png"
    },
    {
      "id": "05-protocol-group",
      "title": "展开 Protocol / Expand Protocol",
      "image": "capture-facets-05-protocol-group.png"
    },
    {
      "id": "06-protocol-select",
      "title": "选择 HTTP/1.1 / Select HTTP/1.1",
      "image": "capture-facets-06-protocol-select.png"
    },
    {
      "id": "07-type-group",
      "title": "展开 Content type / Expand Content type",
      "image": "capture-facets-07-type-group.png"
    },
    {
      "id": "08-json",
      "title": "选择 json，剩一条请求 / Select json to keep one request",
      "image": "capture-facets-08-json.png"
    },
    {
      "id": "09-rule-group",
      "title": "展开 Rule / Expand Rule",
      "image": "capture-facets-09-rule-group.png"
    },
    {
      "id": "10-rule-select",
      "title": "选择实际命中的 Guide facets / Select the matched Guide facets Rule",
      "image": "capture-facets-10-rule-select.png"
    },
    {
      "id": "11-remove-type",
      "title": "取消 json，仍按规则保留一条 / Remove json while the Rule still keeps one request",
      "image": "capture-facets-11-remove-type.png"
    },
    {
      "id": "12-clear-facets",
      "title": "清除分组筛选但保留搜索 / Clear facet selections while keeping search",
      "image": "capture-facets-12-clear-facets.png"
    },
    {
      "id": "13-hide-filters",
      "title": "收起筛选栏 / Hide the filter panel",
      "image": "capture-facets-13-hide-filters.png"
    },
    {
      "id": "14-show-filters",
      "title": "重新显示筛选栏 / Show the filter panel again",
      "image": "capture-facets-14-show-filters.png"
    },
    {
      "id": "15-rules",
      "title": "返回示例规则 / Return to the example Rule",
      "image": "capture-facets-15-rules.png"
    },
    {
      "id": "16-disable",
      "title": "停用 Guide facets / Disable Guide facets",
      "image": "capture-facets-16-disable.png"
    },
    {
      "id": "17-apply-disabled",
      "title": "Apply 停用状态 / Apply the disabled state",
      "image": "capture-facets-17-apply-disabled.png"
    }
  ],
