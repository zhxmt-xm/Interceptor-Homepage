{
  "chapter": "breakpoints-queue",
  "title": {
    "zh-CN": "逐步骤实操：队首、草稿与批量范围",
    "en": "Recorded walkthrough: queue heads, drafts and batch scope"
  },
  "appVersion": "0.1.1-alpha.1",
  "platform": "macOS x64",
  "appLanguage": "zh-CN",
  "sourceRelease": "https://github.com/zhxmt-xm/Interceptor/releases/tag/v0.1.1-alpha.1",
  "releaseAssetSha256": "129e3c3105ebcaf3464d97c47d207912fd13defa26fe719851db92e0f2532c48",
  "example": {
    "postRule": "Guide POST queue",
    "putRule": "Guide PUT queue",
    "path": "/guide/queue",
    "queueKey": "http",
    "postA": "{\"order\":\"POST-A\",\"source\":\"original\"}",
    "postB": "{\"order\":\"POST-B\",\"source\":\"original\"}",
    "putA": "{\"order\":\"PUT-A\",\"source\":\"original\"}",
    "putB": "{\"order\":\"PUT-B\",\"source\":\"original\"}",
    "postC": "{\"order\":\"POST-C\",\"source\":\"original\"}",
    "putC": "{\"order\":\"PUT-C\",\"source\":\"original\"}",
    "draft": "{\"order\":\"POST-A\",\"source\":\"draft-not-submitted\"}",
    "origin": "http://127.0.0.1:56242/"
  },
  "steps": [
    {
      "id": "01-rules",
      "title": "查看两条 Method 规则 / Review the two Method Rules",
      "image": "breakpoints-queue-01-rules.png"
    },
    {
      "id": "02-post-rule",
      "title": "查看 Guide POST queue / Inspect Guide POST queue",
      "image": "breakpoints-queue-02-post-rule.png"
    },
    {
      "id": "03-put-rule",
      "title": "查看 Guide PUT queue / Inspect Guide PUT queue",
      "image": "breakpoints-queue-03-put-rule.png"
    },
    {
      "id": "04-capture",
      "title": "返回 Capture / Return to Capture",
      "image": "breakpoints-queue-04-capture.png"
    },
    {
      "id": "05-post-head",
      "title": "发送 POST-A，成为 Head / Send POST-A as the Head",
      "image": "breakpoints-queue-05-post-head.png"
    },
    {
      "id": "06-post-queued",
      "title": "发送 POST-B，进入 Queued / Send POST-B into Queued",
      "image": "breakpoints-queue-06-post-queued.png"
    },
    {
      "id": "07-put-queued",
      "title": "发送 PUT-A，HTTP 队列共三项 / Send PUT-A into the same HTTP queue",
      "image": "breakpoints-queue-07-put-queued.png"
    },
    {
      "id": "08-select-head",
      "title": "选中 POST-A 队首 / Select the POST-A Head",
      "image": "breakpoints-queue-08-select-head.png"
    },
    {
      "id": "09-text-draft",
      "title": "为队首选择 Text / Choose Text for the Head draft",
      "image": "breakpoints-queue-09-text-draft.png"
    },
    {
      "id": "10-enter-draft",
      "title": "输入未提交草稿 / Enter an unsubmitted draft",
      "image": "breakpoints-queue-10-enter-draft.png"
    },
    {
      "id": "11-post-queued-detail",
      "title": "切到 POST-B，只读 Queued / Inspect POST-B as read-only Queued",
      "image": "breakpoints-queue-11-post-queued-detail.png"
    },
    {
      "id": "12-put-queued-detail",
      "title": "切到 PUT-A，仍在等待 / Inspect PUT-A while it waits",
      "image": "breakpoints-queue-12-put-queued-detail.png"
    },
    {
      "id": "13-restore-draft",
      "title": "回到 Head，草稿保持 / Return to the Head with its draft intact",
      "image": "breakpoints-queue-13-restore-draft.png"
    },
    {
      "id": "14-rule-menu",
      "title": "展开批量操作菜单 / Open the batch actions menu",
      "image": "breakpoints-queue-14-rule-menu.png"
    },
    {
      "id": "15-continue-rule",
      "title": "Continue rule 仅放行 POST，PUT 保留 / Continue the POST Rule and leave PUT pending",
      "image": "breakpoints-queue-15-continue-rule.png"
    },
    {
      "id": "16-put-b",
      "title": "加入 PUT-B / Add PUT-B to the remaining queue",
      "image": "breakpoints-queue-16-put-b.png"
    },
    {
      "id": "18-drop-menu",
      "title": "展开 PUT 队列菜单 / Open the PUT queue menu",
      "image": "breakpoints-queue-18-drop-menu.png"
    },
    {
      "id": "19-drop-queue",
      "title": "Drop queue 丢弃剩余两项 / Drop both remaining HTTP items",
      "image": "breakpoints-queue-19-drop-queue.png"
    },
    {
      "id": "20-new-post",
      "title": "建立新 POST 队首 / Start a new POST Head",
      "image": "breakpoints-queue-20-new-post.png"
    },
    {
      "id": "21-new-put",
      "title": "把 PUT 加入同一 HTTP 队列 / Add PUT to the same HTTP queue",
      "image": "breakpoints-queue-21-new-put.png"
    },
    {
      "id": "22-select-new-head",
      "title": "选中新队首 / Select the new Head",
      "image": "breakpoints-queue-22-select-new-head.png"
    },
    {
      "id": "23-continue-menu",
      "title": "展开整个队列的菜单 / Open the whole-queue menu",
      "image": "breakpoints-queue-23-continue-menu.png"
    },
    {
      "id": "24-continue-queue",
      "title": "Continue queue 原样放行 POST 和 PUT / Continue both Methods without edits",
      "image": "breakpoints-queue-24-continue-queue.png"
    },
    {
      "id": "25-cleanup-rules",
      "title": "返回 Rules 清理 / Return to Rules for cleanup",
      "image": "breakpoints-queue-25-cleanup-rules.png"
    },
    {
      "id": "26-select-post-rule",
      "title": "选中 POST 规则 / Select the POST Rule",
      "image": "breakpoints-queue-26-select-post-rule.png"
    },
    {
      "id": "27-disable-post",
      "title": "停用 POST 规则 / Disable the POST Rule",
      "image": "breakpoints-queue-27-disable-post.png"
    },
    {
      "id": "28-select-put-rule",
      "title": "选中 PUT 规则 / Select the PUT Rule",
      "image": "breakpoints-queue-28-select-put-rule.png"
    },
    {
      "id": "29-disable-put",
      "title": "停用 PUT 规则 / Disable the PUT Rule",
      "image": "breakpoints-queue-29-disable-put.png"
    },
    {
      "id": "30-apply-disabled",
      "title": "Apply 两条停用状态 / Apply both disabled Rules",
      "image": "breakpoints-queue-30-apply-disabled.png"
    }
  ],
