  "example": {
    "filter": "/guide/capture",
    "url": "http://127.0.0.1:58377/guide/capture/orders",
    "response": "{\"orderId\":\"guide-001\",\"message\":\"Hello Interceptor\",\"status\":\"ready\"}",
    "protocolFilter": "/playground",
    "h2Path": "/playground/h2-json",
    "websocketPath": "/playground/ws/text",
    "websocketPayload": "hello from client",
    "grpcPath": "/playground.Capture/UnaryJson",
    "grpcRequest": "{\"message\":\"hello\"}",
    "grpcResponse": "{\"message\":\"world\"}",
    "originException": "localhost (removed after the demonstration)"
  },
